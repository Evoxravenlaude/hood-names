# Deployer key. Use a throwaway key on testnet; use a hardware wallet or multisig flow on mainnet.
PRIVATE_KEY=

# Name registrations sit under. A TLD ("hood") or an ENS-style name ("names.example.eth").
PARENT_NAME=hood

# Optional modules. Leave off for a names-only launch.
ENABLE_REFERRALS=false
ENABLE_GIFT_CARDS=false

# Signer for verified-account attestations (free first name). Leave empty to disable.
DISCOUNT_SIGNER=
# Chainalysis-compatible sanctions oracle. Leave empty to skip screening.
SANCTIONS_LIST=

# Chainlink-style ETH/USD feed. Required on mainnet (4663). Leave empty on testnet to use the fallback rate.
ETH_USD_FEED=
# ETH/USD with 8 decimals, used only when no feed is set (300000000000 = $3,000).
FALLBACK_ETH_USD=300000000000

# Chainlink L2 sequencer uptime feed, if one exists for the chain.
SEQUENCER_UPTIME_FEED=
# Address allowed to pause new sales in an incident (cannot unpause). Required on mainnet.
GUARDIAN=

# USD stablecoin accepted for payment (USDG). Leave empty to accept ETH only at first.
STABLECOIN=

# Comma-separated CCIP-Read batch gateways for the universal resolver. Optional.
BATCH_GATEWAY_URLS=

# Set true to replace an existing deployments/<chainId>.json.
OVERWRITE=false

# Required on mainnet: real metadata endpoints.
WRAPPER_METADATA_URI=https://metadata.example/name/0x{id}
GIFT_CARD_URI=https://metadata.example/giftcard/{id}
