pragma solidity ^0.8.17;

import {Ownable2Step} from "@openzeppelin/contracts/access/Ownable2Step.sol";

/// @title HoodNameRules
/// @notice Decides which labels are well-formed and works out each label's
///         "skeleton": the plainest string it could be mistaken for.
///
/// Names may use any supported alphabet. What they may not do is look like
/// another name. Every allowed character has a prototype, taken from
/// Unicode's confusables data: the Cyrillic "о", the Greek "ο", the digit "0"
/// and the accented "ó" all have the prototype "o". A label's skeleton is its
/// prototypes joined together, so "r0binhood", "robínhood" and "robinhood"
/// share one skeleton. The registrar allows one live name per skeleton, and
/// a reserved name reserves its whole skeleton.
///
/// On top of that:
///  - a label may use one writing system (Japanese may mix kanji and kana,
///    Korean may mix hangul and hanja);
///  - a label in another alphabet whose every letter is an exact double of
///    a Latin letter is an imitation and is refused outright. A letter that
///    merely passes for a Latin one at a glance (the table marks these as
///    "weak") does not trigger refusal, because such letters are needed to
///    write ordinary words; the name then shares its skeleton with the
///    Latin spelling, so the two cannot both exist;
///  - anything that reads like a wallet address is refused;
///  - only lowercase, composed forms are accepted. Interfaces lowercase and
///    normalise what the user types, as ENS interfaces do, so "Alice" and
///    "alice" are the same name.
///
/// A name is priced by the shortest name that shares its look. "vvvvvv"
/// has the skeleton of "www", so it is priced as three characters.
///
/// The character table is data, deployed as contract bytecode in sorted
/// fixed-width records and searched by bisection. It is generated by
/// tools/gen-name-tables.mjs. Once sealed, the tables can only grow in ways
/// that leave every existing label exactly as it was: a new page may not
/// contain a character that already resolves, a new range may not overlap
/// an existing one, and a new script group may not include a script that
/// is already in use.
contract HoodNameRules is Ownable2Step {
    uint256 public constant MIN_LENGTH = 3;
    uint256 public constant MAX_LENGTH = 63;
    /// @dev The name wrapper and DNS encoding hold a label's length in one byte.
    uint256 public constant MAX_BYTES = 255;

    /// @dev Record layout: codepoint (3 bytes), script byte (1: low 7 bits
    ///      the script id, top bit set for a weak fold), prototype length
    ///      (1), prototype (8, UTF-8, left-aligned).
    uint256 private constant RECORD = 13;
    uint256 private constant WEAK = 0x80;
    /// @dev An address-like skeleton is "ox" plus at least this many hex digits.
    uint256 private constant ADDRESS_LIKE_MIN = 8;

    struct Range {
        uint24 start;
        uint24 end;
        uint8 script;
    }

    /// @notice Table pages: contracts whose code is 0x00 followed by records.
    address[] public pages;
    /// @notice Runs of characters that are their own prototype (for example
    ///         CJK ideographs), minus any listed individually in a page.
    Range[] public ranges;
    /// @notice Sets of scripts that may share a label, as bitmasks of script ids.
    uint256[] public groups;
    /// @notice Bit of the Latin script.
    uint256 public immutable latinBit;
    /// @notice Multi-character prototypes, longest first. Each counts as one
    ///         character when a name is priced.
    bytes[] public patterns;
    /// @dev The same patterns packed as 8-byte records (length, then up to
    ///      seven bytes) in a contract's code, and a 256-bit filter over the
    ///      first two bytes of each, so that pricing only walks the list
    ///      where a pattern may actually begin.
    address private patternPage;
    uint256 private patternFilter;
    /// @notice Set once the launch tables are loaded. From then on additions
    ///         are checked so they cannot alter any existing label.
    bool public isSealed;
    uint256 private usedGroupBits;

    error EmptyPage();
    error BadRecord(uint256 index);
    error AlreadyResolves(uint256 codepoint);
    error BadRange();
    error BadGroup();
    error DeployFailed();
    error Sealed();

    event PageAdded(address indexed page, uint256 records);
    event RangeAdded(uint24 start, uint24 end, uint8 script);
    event GroupAdded(uint256 mask);

    constructor(uint256 _latinBit) {
        latinBit = _latinBit;
    }

    /* Admin: append only */

    /// @notice Ends the launch phase. Irreversible.
    function seal() external onlyOwner {
        isSealed = true;
    }

    /// @param data 0x00 followed by records sorted by codepoint.
    function addPage(bytes calldata data) external onlyOwner returns (address page) {
        if (
            data.length <= 1 ||
            data.length > 24_576 ||
            (data.length - 1) % RECORD != 0 ||
            data[0] != 0
        ) revert EmptyPage();

        uint256 n = (data.length - 1) / RECORD;
        uint256 previous;
        // Read the existing tables once, not once per record.
        bytes[] memory tables;
        if (isSealed) tables = _tables();
        for (uint256 i = 0; i < n; i++) {
            uint256 o = 1 + i * RECORD;
            uint256 cp = (uint256(uint8(data[o])) << 16) |
                (uint256(uint8(data[o + 1])) << 8) |
                uint256(uint8(data[o + 2]));
            uint256 plen = uint8(data[o + 4]);
            // Strictly ascending, a sane prototype, a real script id.
            if (
                (i != 0 && cp <= previous) ||
                plen == 0 ||
                plen > 8 ||
                (uint8(data[o + 3]) & 0x7f) > 31
            ) revert BadRecord(i);
            if (isSealed) {
                (bool found, , , ) = _lookupIn(tables, cp);
                if (found) revert AlreadyResolves(cp);
            }
            previous = cp;
        }

        page = _deploy(data);
        pages.push(page);
        emit PageAdded(page, n);
    }

    function addRanges(Range[] calldata _ranges) external onlyOwner {
        for (uint256 i = 0; i < _ranges.length; i++) {
            Range calldata r = _ranges[i];
            if (r.end < r.start || r.script == 0 || r.script > 31)
                revert BadRange();
            uint256 existing = ranges.length;
            for (uint256 k = 0; k < existing; k++) {
                if (r.start <= ranges[k].end && ranges[k].start <= r.end)
                    revert BadRange();
            }
            ranges.push(r);
            emit RangeAdded(r.start, r.end, r.script);
        }
    }

    /// @dev After sealing, a new group may only combine scripts that no
    ///      existing group uses, so it cannot legalise a mix that was refused.
    function addGroups(uint256[] calldata masks) external onlyOwner {
        for (uint256 i = 0; i < masks.length; i++) {
            if (masks[i] == 0 || (isSealed && masks[i] & usedGroupBits != 0))
                revert BadGroup();
            groups.push(masks[i]);
            emit GroupAdded(masks[i]);
        }
        for (uint256 i = 0; i < masks.length; i++) usedGroupBits |= masks[i];
    }

    /// @notice Launch phase only, once: the multi-character prototypes,
    ///         longest first, each two to seven bytes.
    function addPatterns(bytes[] calldata _patterns) external onlyOwner {
        if (isSealed || patternPage != address(0)) revert Sealed();
        bytes memory data = new bytes(1 + _patterns.length * 8);
        uint256 filter;
        uint256 previous = type(uint256).max;
        for (uint256 i = 0; i < _patterns.length; i++) {
            bytes calldata pat = _patterns[i];
            uint256 len = pat.length;
            if (len < 2 || len > 7 || len > previous) revert BadRecord(i);
            previous = len;
            data[1 + i * 8] = bytes1(uint8(len));
            for (uint256 j = 0; j < len; j++) data[2 + i * 8 + j] = pat[j];
            filter |= 1 << _pairSlot(uint8(pat[0]), uint8(pat[1]));
            patterns.push(pat);
        }
        patternPage = _deploy(data);
        patternFilter = filter;
    }

    function _pairSlot(uint256 first, uint256 second) private pure returns (uint256) {
        return (first * 31 + second) & 0xff;
    }

    function counts() external view returns (uint256, uint256, uint256) {
        return (pages.length, ranges.length, groups.length);
    }

    /* Rules */

    /// @notice Whether `label` is well-formed, and if so the hash of its
    ///         skeleton, its length in characters, and the length it is
    ///         priced at (that of the shortest name with the same skeleton).
    function check(
        string calldata label
    )
        external
        view
        returns (bool ok, bytes32 skeletonHash, uint256 length, uint256 priceLength)
    {
        bytes memory skel;
        (ok, skel, length) = _check(bytes(label));
        if (ok) {
            skeletonHash = keccak256(skel);
            uint256 units = _units(skel);
            priceLength = units < length ? units : length;
        }
    }

    /// @notice The skeleton itself, for inspection and tests.
    function skeleton(
        string calldata label
    ) external view returns (bool ok, bytes memory skel) {
        (ok, skel, ) = _check(bytes(label));
    }

    struct Scan {
        bytes skel;
        uint256 skelLen;
        uint256 mask;
        uint256 count;
        // Every letter so far is an exact double of a plain ASCII character.
        bool exact;
        // The table pages, read into memory once per label.
        bytes[] tables;
    }

    function _check(
        bytes calldata b
    ) internal view returns (bool, bytes memory, uint256) {
        bytes memory none;
        uint256 n = b.length;
        if (n < MIN_LENGTH || n > MAX_BYTES) return (false, none, 0);
        // Hyphens: not at either end, not doubled in the third and fourth
        // positions (the punycode marker).
        if (b[0] == "-" || b[n - 1] == "-") return (false, none, 0);

        Scan memory s;
        s.skel = new bytes(n * 8);
        s.exact = true;
        s.tables = _tables();
        uint256 i;
        while (i < n) {
            (uint256 cp, uint256 size) = _decode(b, i);
            if (size == 0) return (false, none, 0);
            if (s.count == 3 && cp == 0x2d && b[i - 1] == "-")
                return (false, none, 0);
            if (!_append(s, cp)) return (false, none, 0);
            i += size;
            if (++s.count > MAX_LENGTH) return (false, none, 0);
        }
        if (s.count < MIN_LENGTH || !_scriptsAllowed(s.mask, s.exact))
            return (false, none, 0);

        bytes memory skel = s.skel;
        uint256 skelLen = s.skelLen;
        assembly {
            mstore(skel, skelLen)
        }
        if (_addressLike(skel)) return (false, none, 0);
        return (true, skel, s.count);
    }

    /// @dev Adds one character's prototype to the skeleton. False if the
    ///      character is not in the tables.
    function _append(Scan memory s, uint256 cp) internal view returns (bool) {
        (bool found, uint256 scriptByte, uint256 plen, bytes8 proto) = _lookupIn(
            s.tables,
            cp
        );
        if (!found) return false;
        uint256 script = scriptByte & 0x7f;
        bool ascii = true;
        for (uint256 k = 0; k < plen; k++) {
            bytes1 c = proto[k];
            if (uint8(c) > 0x7f) ascii = false;
            s.skel[s.skelLen++] = c;
        }
        if (script != 0) {
            s.mask |= 1 << script;
            if (!ascii || scriptByte & WEAK != 0) s.exact = false;
        }
        return true;
    }

    function _scriptsAllowed(uint256 mask, bool exact) internal view returns (bool) {
        if (mask == 0) return true; // digits and hyphens only
        // Another alphabet, every letter an exact double of a Latin one.
        if (exact && (mask & ~latinBit) != 0) return false;
        uint256 g = groups.length;
        for (uint256 k = 0; k < g; k++) {
            if (mask & ~groups[k] == 0) return true;
        }
        return false;
    }

    /// @dev "ox" followed only by hex digits as they appear in a skeleton,
    ///      where 0 has become o and 1 has become l.
    function _addressLike(bytes memory skel) internal pure returns (bool) {
        uint256 n = skel.length;
        if (n < 2 + ADDRESS_LIKE_MIN || skel[0] != "o" || skel[1] != "x")
            return false;
        for (uint256 i = 2; i < n; i++) {
            bytes1 c = skel[i];
            bool hexDigit = (c >= "2" && c <= "9") ||
                (c >= "a" && c <= "f") ||
                c == "o" ||
                c == "l";
            if (!hexDigit) return false;
        }
        return true;
    }

    /// @dev Deploys a contract whose runtime code is `data`.
    function _deploy(bytes memory data) internal returns (address page) {
        bytes memory init = abi.encodePacked(
            hex"61",
            uint16(data.length),
            hex"80600c6000396000f3",
            data
        );
        assembly {
            page := create(0, add(init, 32), mload(init))
        }
        if (page == address(0)) revert DeployFailed();
    }

    /// @dev Characters in the shortest name with this skeleton: a
    ///      multi-character prototype counts once.
    function _units(bytes memory skel) internal view returns (uint256 n) {
        uint256 filter = patternFilter;
        uint256 len = skel.length;
        bytes memory pats;
        uint256 count;
        uint256 i;
        unchecked {
            while (i < len) {
                uint256 b0 = uint8(skel[i]);
                uint256 step;
                if (
                    i + 1 < len &&
                    filter & (1 << _pairSlot(b0, uint8(skel[i + 1]))) != 0
                ) {
                    if (pats.length == 0) {
                        // Loaded only when a name may contain a pattern.
                        pats = patternPage.code;
                        count = (pats.length - 1) / 8;
                    }
                    uint256 left = len - i;
                    assembly {
                        // The next seven bytes of the skeleton. Bytes past
                        // its end are whatever follows in memory, so a
                        // pattern longer than what is left is never matched.
                        let window := shr(200, mload(add(add(skel, 32), i)))
                        let at := add(pats, 33)
                        let end := add(at, mul(count, 8))
                        for {} lt(at, end) { at := add(at, 8) } {
                            let record := shr(192, mload(at))
                            let pl := shr(56, record)
                            if gt(pl, left) { continue }
                            let shift := mul(sub(7, pl), 8)
                            if eq(
                                shr(shift, and(record, 0xffffffffffffff)),
                                shr(shift, window)
                            ) {
                                step := pl
                                break
                            }
                        }
                    }
                }
                if (step == 0)
                    step = b0 < 0x80 ? 1 : b0 < 0xe0 ? 2 : b0 < 0xf0 ? 3 : 4;
                i += step;
                n++;
            }
        }
    }

    /// @dev Strict UTF-8: rejects overlong forms, surrogates, stray
    ///      continuation bytes and anything above U+10FFFF.
    function _decode(
        bytes calldata b,
        uint256 i
    ) internal pure returns (uint256 cp, uint256 size) {
        uint256 n = b.length;
        uint256 b0 = uint8(b[i]);
        if (b0 < 0x80) return (b0, 1);
        if (b0 >= 0xc2 && b0 <= 0xdf) {
            if (i + 1 >= n) return (0, 0);
            uint256 b1 = uint8(b[i + 1]);
            if (b1 & 0xc0 != 0x80) return (0, 0);
            return (((b0 & 0x1f) << 6) | (b1 & 0x3f), 2);
        }
        if (b0 >= 0xe0 && b0 <= 0xef) {
            if (i + 2 >= n) return (0, 0);
            uint256 b1 = uint8(b[i + 1]);
            uint256 b2 = uint8(b[i + 2]);
            if (b1 & 0xc0 != 0x80 || b2 & 0xc0 != 0x80) return (0, 0);
            cp = ((b0 & 0x0f) << 12) | ((b1 & 0x3f) << 6) | (b2 & 0x3f);
            if (cp < 0x800 || (cp >= 0xd800 && cp <= 0xdfff)) return (0, 0);
            return (cp, 3);
        }
        if (b0 >= 0xf0 && b0 <= 0xf4) {
            if (i + 3 >= n) return (0, 0);
            uint256 b1 = uint8(b[i + 1]);
            uint256 b2 = uint8(b[i + 2]);
            uint256 b3 = uint8(b[i + 3]);
            if (b1 & 0xc0 != 0x80 || b2 & 0xc0 != 0x80 || b3 & 0xc0 != 0x80)
                return (0, 0);
            cp =
                ((b0 & 0x07) << 18) |
                ((b1 & 0x3f) << 12) |
                ((b2 & 0x3f) << 6) |
                (b3 & 0x3f);
            if (cp < 0x10000 || cp > 0x10ffff) return (0, 0);
            return (cp, 4);
        }
        return (0, 0);
    }

    function _tables() internal view returns (bytes[] memory tables) {
        uint256 p = pages.length;
        tables = new bytes[](p);
        for (uint256 k = 0; k < p; k++) tables[k] = pages[k].code;
    }

    function _lookupIn(
        bytes[] memory tables,
        uint256 cp
    ) internal view returns (bool found, uint256 script, uint256 plen, bytes8 proto) {
        uint256 p = tables.length;
        for (uint256 k = 0; k < p; k++) {
            bytes memory table = tables[k];
            uint256 lo = 0;
            uint256 hi = (table.length - 1) / RECORD;
            while (lo < hi) {
                uint256 mid = (lo + hi) >> 1;
                uint256 word;
                assembly {
                    // Skips the 32-byte length and the leading 0x00.
                    word := mload(add(add(table, 33), mul(mid, 13)))
                }
                uint256 at = word >> 232;
                if (at == cp) {
                    script = (word >> 224) & 0xff;
                    plen = (word >> 216) & 0xff;
                    proto = bytes8(uint64(word >> 152));
                    return (true, script, plen, proto);
                }
                if (at < cp) lo = mid + 1;
                else hi = mid;
            }
        }
        uint256 r = ranges.length;
        for (uint256 k = 0; k < r; k++) {
            Range memory range = ranges[k];
            if (cp >= range.start && cp <= range.end) {
                // Its own prototype: the character's UTF-8 bytes.
                (proto, plen) = _encode(cp);
                return (true, range.script, plen, proto);
            }
        }
    }

    function _encode(uint256 cp) internal pure returns (bytes8 out, uint256 len) {
        if (cp < 0x80) return (bytes8(bytes1(uint8(cp))), 1);
        if (cp < 0x800) {
            return (
                bytes8(
                    bytes2(
                        uint16(((0xc0 | (cp >> 6)) << 8) | (0x80 | (cp & 0x3f)))
                    )
                ),
                2
            );
        }
        if (cp < 0x10000) {
            return (
                bytes8(
                    bytes3(
                        uint24(
                            ((0xe0 | (cp >> 12)) << 16) |
                                ((0x80 | ((cp >> 6) & 0x3f)) << 8) |
                                (0x80 | (cp & 0x3f))
                        )
                    )
                ),
                3
            );
        }
        return (
            bytes8(
                bytes4(
                    uint32(
                        ((0xf0 | (cp >> 18)) << 24) |
                            ((0x80 | ((cp >> 12) & 0x3f)) << 16) |
                            ((0x80 | ((cp >> 6) & 0x3f)) << 8) |
                            (0x80 | (cp & 0x3f))
                    )
                )
            ),
            4
        );
    }
}
